{
  "schemaVersion": 1,
  "package": {
    "name": "elegy-copilot-codex",
    "version": "0.1.0",
    "sourceCommitSha": "<REPLACE_WITH_GIT_SHA>"
  },
  "installDefaults": {
    "codexHome": "~/.codex",
    "agentsDir": "~/.codex/agents",
    "skillsDir": "~/.codex/skills",
    "instructionsFile": "~/.codex/AGENTS.md",
    "configFile": "~/.codex/config.toml",
    "description": "Home-installed Codex session assets for planning-first work, review, and minimal repository setup."
  },
  "installerHints": {
    "preferExplicitDestinations": true,
    "agentsAreFlat": true,
    "skillsRequireFolderName": true,
    "notes": "Install the six native Codex role agents and six Elegy compatibility skills under ~/.codex. Native agents and Codex configuration remain harness-owned; Elegy plugins are installed through the Codex marketplace."
  },
  "governance": {
    "g05": {
      "schemaVersion": "1.0.0",
      "requiredControls": {
        "early": [
          {
            "id": "safetyTokenParity",
            "owner": "Security Engineering"
          },
          {
            "id": "hookEnforcement",
            "owner": "Platform Engineering"
          },
          {
            "id": "telemetrySchemaValidation",
            "owner": "Observability Engineering"
          }
        ],
        "final": [
          {
            "id": "evidencePredicates",
            "owner": "Release Engineering"
          },
          {
            "id": "finalGateWaiverPrecedence",
            "owner": "Security Engineering"
          },
          {
            "id": "trustedEvidenceBindingRetention",
            "owner": "Release Engineering"
          }
        ]
      }
    }
  },
  "assets": [
    {
      "id": "codex-global-instructions",
      "type": "instructions",
      "source": "catalog-assets/instructions/agent-session-defaults.md",
      "destination": "AGENTS.md",
      "management": {
        "owner": "elegy",
        "sourceOfTruth": "elegy-catalog",
        "scope": "global",
        "readOnly": false
      },
      "appendix": "codex-assets/home/AGENTS-appendix.md"
    },
    {
      "id": "codex-explorer-agent",
      "type": "agent",
      "source": "codex-assets/agents/explorer.toml",
      "destination": "agents/explorer.toml",
      "management": {
        "owner": "harness",
        "sourceOfTruth": "codex",
        "scope": "global",
        "readOnly": true,
        "readOnlyReason": "Native Codex asset; manage it through Codex."
      }
    },
    {
      "id": "codex-reviewer-agent",
      "type": "agent",
      "source": "codex-assets/agents/reviewer.toml",
      "destination": "agents/reviewer.toml",
      "management": {
        "owner": "harness",
        "sourceOfTruth": "codex",
        "scope": "global",
        "readOnly": true,
        "readOnlyReason": "Native Codex asset; manage it through Codex."
      }
    },
    {
      "id": "codex-reviewer-strong-agent",
      "type": "agent",
      "source": "codex-assets/agents/reviewer_strong.toml",
      "destination": "agents/reviewer_strong.toml",
      "management": {
        "owner": "harness",
        "sourceOfTruth": "codex",
        "scope": "global",
        "readOnly": true,
        "readOnlyReason": "Native Codex asset; manage it through Codex."
      }
    },
    {
      "id": "codex-worker-agent",
      "type": "agent",
      "source": "codex-assets/agents/worker.toml",
      "destination": "agents/worker.toml",
      "management": {
        "owner": "harness",
        "sourceOfTruth": "codex",
        "scope": "global",
        "readOnly": true,
        "readOnlyReason": "Native Codex asset; manage it through Codex."
      }
    },
    {
      "id": "codex-test-runner-agent",
      "type": "agent",
      "source": "codex-assets/agents/test-runner.toml",
      "destination": "agents/test-runner.toml",
      "management": {
        "owner": "harness",
        "sourceOfTruth": "codex",
        "scope": "global",
        "readOnly": true,
        "readOnlyReason": "Native Codex asset; manage it through Codex."
      }
    },
    {
      "id": "codex-sweeper-agent",
      "type": "agent",
      "source": "codex-assets/agents/sweeper.toml",
      "destination": "agents/sweeper.toml",
      "management": {
        "owner": "harness",
        "sourceOfTruth": "codex",
        "scope": "global",
        "readOnly": true,
        "readOnlyReason": "Native Codex asset; manage it through Codex."
      }
    },
    {
      "id": "codex-repo-setup-skill",
      "type": "skill",
      "source": "codex-assets/skills/repo-setup",
      "destination": "skills/repo-setup",
      "management": {
        "owner": "elegy",
        "sourceOfTruth": "elegy-catalog",
        "scope": "global",
        "readOnly": false
      }
    },
    {
      "id": "codex-repo-backed-obsidian-docs-skill",
      "type": "skill",
      "source": "catalog-assets/shared-skills/repo-backed-obsidian-docs",
      "destination": "skills/repo-backed-obsidian-docs",
      "loadMode": "on-demand",
      "management": {
        "owner": "elegy",
        "sourceOfTruth": "elegy-catalog",
        "scope": "global",
        "readOnly": false
      }
    },
    {
      "id": "codex-sweeper-cleanup-skill",
      "type": "skill",
      "source": "catalog-assets/shared-skills/sweeper-cleanup",
      "destination": "skills/sweeper-cleanup",
      "loadMode": "on-demand",
      "management": {
        "owner": "elegy",
        "sourceOfTruth": "elegy-catalog",
        "scope": "global",
        "readOnly": false
      }
    },
    {
      "id": "codex-repo-quality-setup-skill",
      "type": "skill",
      "source": "engine-assets/skills/repo-quality-setup",
      "destination": "skills/repo-quality-setup",
      "loadMode": "on-demand",
      "management": {
        "owner": "elegy",
        "sourceOfTruth": "elegy-catalog",
        "scope": "global",
        "readOnly": false
      }
    },
    {
      "id": "codex-agents-md-authoring-skill",
      "type": "skill",
      "source": "catalog-assets/shared-skills/agents-md-authoring",
      "destination": "skills/agents-md-authoring",
      "loadMode": "on-demand",
      "management": {
        "owner": "elegy",
        "sourceOfTruth": "elegy-catalog",
        "scope": "global",
        "readOnly": false
      }
    },
    {
      "id": "codex-tdd-skill",
      "type": "skill",
      "source": "catalog-assets/shared-skills/tdd",
      "destination": "skills/tdd",
      "loadMode": "on-demand",
      "management": {
        "owner": "elegy",
        "sourceOfTruth": "elegy-catalog",
        "scope": "global",
        "readOnly": false
      }
    }
  ],
  "sourcePatterns": []
}
